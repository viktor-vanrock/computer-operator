DATABASE_URL=postgresql://user:password@localhost:5432/dbname

PORT=3001
NODE_ENV=development
LOG_LEVEL=info
AGENT_MANAGER_API_URL=localhost
AGENT_MANAGER_USERNAME=<user>
AGENT_MANAGER_PASSWORD=<pass>

# VM Fleet — inventory and lifecycle of reserved VMs
# Token must include fleet:create for POST /api/v1/vms/{id}/assign.
VMFLEET_URL=https://vm-fleet.example.internal
VMFLEET_TOKEN=vmf_...
DEFAULT_IMAGE_ID=8b2a638d-cdac-479e-9152-5d00b3164707
VMFLEET_PROFILE=reserved_vm

# Full-duplex mode — отдельный сервис
FULL_DUPLEX_API_URL=localhost
FULL_DUPLEX_USERNAME=<user>
FULL_DUPLEX_PASSWORD=<pass>
  
GUACAMOLE_URL=https://guacamole.devops.mlrnd.ru/guacamole
GUACAMOLE_ADMIN_USERNAME=
GUACAMOLE_ADMIN_PASSWORD=
# Optional: token for Prometheus scrape authentication (X-Metrics-Token header)
# METRICS_TOKEN=your-secret-token

# Keycloak / Auth
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=my-realm
KEYCLOAK_CLIENT_ID=frontend-tech
KEYCLOAK_CLIENT_SECRET=your-client-secret
# Мин. 32 символа, случайная строка (например: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
FRONTEND_TECH_URL=http://localhost:5174
# В prod выставить реальный URL бэкенда (используется для callback URI в OAuth2-флоу)
# BACKEND_URL=https://api.example.com

# GigaChat moderation
# Секреты должны поступать из локального .env или Vault и не коммититься.
GIGACHAT_AUTHORIZATION_KEY=replace-with-gigachat-authorization-key
# Мин. 32 символа; на всех репликах backend должно быть одинаковое значение.
TASK_VALIDATION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Необязательные настройки модерации (ниже указаны значения по умолчанию)
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TIMEOUT_MS=5000
FREEFORM_TASK_MAX_LENGTH=4000
TASK_VALIDATION_TTL_MS=120000
