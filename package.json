{
  "name": "ui-agent-arena",
  "version": "0.0.1",
  "private": true,
  "description": "UI-Agent Arena — демо-платформа Computer Use Operator (Sber AI)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "npm run dev:backend & npm run dev:demo & npm run dev:tech",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:demo": "npm run dev --workspace=apps/frontend-demo",
    "dev:tech": "npm run dev --workspace=apps/frontend-tech",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "eslint-import-resolver-typescript": "^4.4.4"
  }
}
